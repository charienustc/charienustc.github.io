---
import { NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === base || pathname === base.replace(/\/$/, '');
  return pathname.startsWith(base + href.replace(/^\//, ''));
}
---

<header class="sticky top-0 z-40 liquid-glass">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-center relative">
    <nav class="flex items-center gap-1 sm:gap-2 text-sm font-medium">
      {NAV_LINKS.map((link) => (
        <a
          href={base + link.href.replace(/^\//, '')}
          class:list={[
            'px-3 py-1.5 rounded-full transition-colors',
            isActive(link.href)
              ? 'bg-accent text-accent-text'
              : 'text-ink-soft hover:bg-accent-soft hover:text-accent',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="absolute right-4 sm:right-6 lg:right-8 top-1/2 -translate-y-1/2">
      <ThemeToggle />
    </div>
  </div>
</header>
