---
import { NAV_LINKS, AUTHOR } from '../consts';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === base || pathname === base.replace(/\/$/, '');
  return pathname.startsWith(base + href.replace(/^\//, ''));
}
---

<header class="site-header sticky top-0 z-50" data-scrolled="false">
  <div class="mx-auto w-full max-w-3xl px-5 sm:px-8 h-16 flex items-center justify-between gap-6">
    <a
      href={base}
      class="font-serif text-lg font-bold tracking-tight text-ink hover:text-accent transition-colors"
    >
      {AUTHOR}
    </a>

    <div class="flex items-center gap-5 sm:gap-7">
      <nav class="flex items-center gap-5 sm:gap-7 text-sm">
        {NAV_LINKS.map((link) => (
          <a
            href={base + link.href.replace(/^\//, '')}
            data-active={isActive(link.href) ? 'true' : 'false'}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class="nav-link"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label="切换明暗主题"
        title="切换明暗主题"
      >
        <svg class="icon-moon w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
        <svg class="icon-sun w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // ClientRouter 软导航会替换 <header>,元素引用一律惰性查询,监听委托到 document。
  const headerEl = () => document.querySelector<HTMLElement>('.site-header');

  function syncScrolled() {
    const header = headerEl();
    if (header) header.dataset.scrolled = window.scrollY > 4 ? 'true' : 'false';
  }

  syncScrolled();
  window.addEventListener('scroll', syncScrolled, { passive: true });
  document.addEventListener('astro:page-load', syncScrolled);

  document.addEventListener('click', (event) => {
    const btn = event.target instanceof Element ? event.target.closest('[data-theme-toggle]') : null;
    if (!btn) return;
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>
