---
import { NAV_LINKS } from '../consts';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === base || pathname === base.replace(/\/$/, '');
  return pathname.startsWith(base + href.replace(/^\//, ''));
}
---

<!-- SVG 滤镜:为液态玻璃提供轻微折射与色差 -->
<svg width="0" height="0" class="absolute" aria-hidden="true">
  <defs>
    <filter id="liquid-glass-refraction" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.015" numOctaves="2" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="4" xChannelSelector="R" yChannelSelector="G" result="displacement" />
      <feGaussianBlur in="displacement" stdDeviation="0.6" result="blurred" />
      <feColorMatrix in="blurred" type="matrix" values="
        1.02 0    0    0 0
        0    0.98 0    0 0
        0    0    1.03 0 0
        0    0    0    1 0
      " result="chromatic" />
      <feMerge>
        <feMergeNode in="chromatic" />
      </feMerge>
    </filter>
  </defs>
</svg>

<div class="header-fade" aria-hidden="true"></div>

<header class="sticky top-4 z-50 flex justify-center px-4">
  <div class="ios-liquid-glass-pill">
    <nav class="relative z-10 flex items-center gap-0.5 sm:gap-1 text-sm font-medium">
      {NAV_LINKS.map((link) => (
        <a
          href={base + link.href.replace(/^\//, '')}
          class:list={[
            'px-3 sm:px-4 py-2 rounded-full transition-all duration-200',
            isActive(link.href)
              ? 'bg-white/12 text-ink shadow-sm'
              : 'text-ink-soft hover:text-ink hover:bg-white/8',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const fade = document.querySelector<HTMLElement>('.header-fade');
  if (fade) {
    const sync = () => {
      fade.dataset.visible = window.scrollY > 8 ? 'true' : 'false';
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
    document.addEventListener('astro:after-swap', sync);
  }
</script>
