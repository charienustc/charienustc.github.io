---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index } = Astro.props;
const { title, description, tags, url, repo, featured } = project.data;
const mainHref = url ?? repo;
---

<div class="row group py-5 sm:py-6" data-reveal>
  <div class="flex items-baseline gap-4 sm:gap-7">
    {typeof index === 'number' && (
      <span class="label shrink-0 w-7">{String(index + 1).padStart(2, '0')}</span>
    )}
    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <h3 class="font-serif text-base sm:text-lg font-semibold text-ink">
          {mainHref ? (
            <a href={mainHref} target="_blank" rel="noopener" class="row-title inline-block">
              {title}
            </a>
          ) : (
            title
          )}
        </h3>
        {featured && <span class="label text-accent">精选</span>}
      </div>
      <p class="mt-1.5 text-sm text-ink-soft leading-relaxed line-clamp-2">{description}</p>
      <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
    <div class="hidden sm:flex flex-col items-end gap-1.5 shrink-0 text-sm font-medium">
      {url && (
        <a href={url} target="_blank" rel="noopener" class="link-underline text-ink-soft hover:text-ink">
          Demo ↗
        </a>
      )}
      {repo && (
        <a href={repo} target="_blank" rel="noopener" class="link-underline text-ink-soft hover:text-ink">
          Repo ↗
        </a>
      )}
    </div>
  </div>
  <div class="sm:hidden mt-3 flex gap-5 text-sm font-medium">
    {url && (
      <a href={url} target="_blank" rel="noopener" class="link-underline text-ink-soft">Demo ↗</a>
    )}
    {repo && (
      <a href={repo} target="_blank" rel="noopener" class="link-underline text-ink-soft">Repo ↗</a>
    )}
  </div>
</div>
