---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import Tag from './Tag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const { title, description, tags, url, repo, thumbnail, featured } = project.data;
---

<Card class="flex flex-col h-full overflow-hidden group">
  {thumbnail ? (
    <div class="aspect-[16/10] overflow-hidden bg-paper border-b border-line">
      <img
        src={thumbnail.startsWith('http') ? thumbnail : base + thumbnail}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="aspect-[16/10] bg-accent-soft border-b border-line flex items-center justify-center">
      <span class="font-serif text-4xl font-bold text-accent/30">{title.charAt(0)}</span>
    </div>
  )}
  <div class="p-5 sm:p-6 flex flex-col flex-1">
    <div class="flex items-start justify-between gap-3 mb-2">
      <h3 class="font-serif text-xl font-bold text-ink group-hover:text-accent transition-colors">
        {title}
      </h3>
      {featured && (
        <span class="shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-accent text-accent-text">
          精选
        </span>
      )}
    </div>
    <p class="text-ink-soft text-sm leading-relaxed line-clamp-2 mb-4">{description}</p>
    <div class="flex flex-wrap gap-1.5 mb-4">
      {tags.map((tag) => <span class="tag pointer-events-none">{tag}</span>)}
    </div>
    <div class="mt-auto flex items-center gap-4 text-sm font-medium">
      {url && (
        <a href={url} target="_blank" rel="noopener" class="inline-flex items-center text-accent hover:opacity-75 transition-opacity">
          Demo
          <svg class="w-3.5 h-3.5 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3" />
          </svg>
        </a>
      )}
      {repo && (
        <a href={repo} target="_blank" rel="noopener" class="inline-flex items-center text-ink-soft hover:text-accent transition-colors">
          Repo
          <svg class="w-3.5 h-3.5 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 .89-3.4 2.5C13.36 2.5 11.76 2 10 2s-3.36.5-5.6 1.5c-2.4-1.61-3.4-2.5-3.4-2.5A5.06 5.06 0 0 0 1 4.5c0 3.5 3 5.5 6 5.5a4.8 4.8 0 0 0-1 3.5v4" />
          </svg>
        </a>
      )}
    </div>
  </div>
</Card>
