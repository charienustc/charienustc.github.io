---
interface Props {
  kicker?: string;
  title: string;
  desc?: string;
}

const { kicker, title, desc } = Astro.props;
---

<header class="mb-10 sm:mb-14" data-reveal>
  {kicker && <p class="label mb-4">{kicker}</p>}
  <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-ink" style="text-wrap: balance">
    {title}
  </h1>
  {desc && <p class="mt-4 text-ink-soft leading-relaxed max-w-xl">{desc}</p>}
  <slot />
</header>
