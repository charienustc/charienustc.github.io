---
interface Props {
  title: string;
  href?: string;
  linkText?: string;
}

const { title, href, linkText = '查看全部' } = Astro.props;
---

<div class="border-t-2 border-ink pt-5 mb-8 flex items-baseline justify-between gap-4" data-reveal>
  <h2 class="font-serif text-3xl sm:text-4xl font-bold text-ink tracking-tight">{title}</h2>
  {href && (
    <a href={href} class="text-sm text-ink-soft hover:text-ink link-underline shrink-0">
      {linkText} →
    </a>
  )}
</div>
