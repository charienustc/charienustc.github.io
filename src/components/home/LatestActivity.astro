---
/**
 * Homepage "latest activity" block: the newest article and the newest moment,
 * side by side on desktop and stacked on mobile.
 *
 * Moments deliberately have no per-entry pages — the feed is the whole feature —
 * so the moment entry links to /moments/ rather than anchoring a specific entry.
 * The article entry points at the first post of the list below, so the same
 * article intentionally appears twice on the home page: once as the latest
 * activity, once in the full list.
 */
import { getCollection } from 'astro:content';
import ActivityCard from '@components/home/ActivityCard';
import { Routes } from '@constants/router';
import { momentExcerpt, selectVisibleMoments } from '@lib/content/moments';
import { displayDate } from '@lib/date';
import { routeBuilder } from '@lib/route';
import Divider from '@/components/ui/divider';
import { localizedPath, t } from '@/i18n';
import type { PostCardData } from '@/types/blog';

interface Props {
  locale: string;
  post?: PostCardData;
}

const { locale, post } = Astro.props;

const latest = selectVisibleMoments(await getCollection('moments'), import.meta.env.PROD)[0];

const articleHref = post
  ? localizedPath(routeBuilder(Routes.Post, { slug: post.slug, link: post.link, title: post.title }), locale)
  : undefined;
const momentsHref = localizedPath('/moments', locale);
---

{
  (post || latest) && (
    <>
      <Divider>{t(locale, 'home.latestActivity')}</Divider>
      <div class="grid grid-cols-2 gap-x-8 md:grid-cols-1 md:gap-y-4">
        {post && articleHref && (
          <ActivityCard
            client:load
            href={articleHref}
            icon="lucide:pen-tool"
            label={t(locale, 'nav.posts')}
            dateText={displayDate.date(post.date)}
            dateTime={post.date.toISOString()}
            text={post.title}
          />
        )}
        {latest && (
          <ActivityCard
            client:load
            href={momentsHref}
            icon="lucide:message-circle"
            label={t(locale, 'nav.moments')}
            dateText={displayDate.date(latest.data.date)}
            dateTime={latest.data.date.toISOString()}
            text={momentExcerpt(latest.body ?? '')}
          />
        )}
      </div>
    </>
  )
}
