---
interface Props {
  title: string;
  description?: string;
  href?: string;
  linkText?: string;
}

const { title, description, href, linkText } = Astro.props;
---

<div class="border-y border-line py-14 text-center" data-reveal>
  <p class="font-serif text-xl font-semibold text-ink">{title}</p>
  {description && <p class="mt-2 text-sm text-muted leading-relaxed max-w-sm mx-auto">{description}</p>}
  {
    href && linkText && (
      <a href={href} class="inline-block mt-5 text-sm font-medium text-accent link-underline">
        {linkText} →
      </a>
    )
  }
</div>
