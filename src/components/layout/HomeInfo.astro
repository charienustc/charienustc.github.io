---
import ChristmasHat from '@components/christmas/ChristmasHat.astro';
import ButtonLink from '@components/control/ButtonLink.astro';
import type { HomeSiderType } from '@constants/enum';
import { RESERVED_ROUTES } from '@constants/router';
import { christmasConfig, configuredSeriesSlugs, enabledSeriesSlugs, routers, siteConfig } from '@constants/site-config';
import { buildTagPath, getAllTags, getCategoryList, getPostCount, getSortedPosts } from '@lib/content';
import { getLqipStyle } from '@lib/lqip';
import { cn, filterNavItems } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import { getLocaleFromUrl, localizedPath, resolveNavName, stripLocaleFromPath, t } from '@/i18n';
import type { BlogSchema } from '@/types/blog';
import Social from './Social.astro';

interface Props {
  type?: HomeSiderType;
  className?: string;
  isDrawer?: boolean;
  frontmatter?: BlogSchema;
}

const locale = getLocaleFromUrl(Astro.url.pathname);
const postCount = await getPostCount(locale);
const { countMap } = await getCategoryList(locale);
const posts = await getSortedPosts(locale);
const tags = getAllTags(posts);

const allTags = Object.entries(tags)
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => b.count - a.count);

// 生成唯一 ID 前缀
const uniqueId = `home-info-${Math.random().toString(36).substring(2, 11)}`;
const { className, isDrawer = false } = Astro.props;

// Filter navigation items to exclude disabled series
const filteredRouters = filterNavItems(routers, configuredSeriesSlugs, enabledSeriesSlugs, RESERVED_ROUTES);
const strippedPath = stripLocaleFromPath(Astro.url.pathname);

// Normalize description to array for random selection
const descriptions = Array.isArray(siteConfig.description) ? siteConfig.description : [siteConfig.description ?? ''];

const fortunes = {
  good: [
    '宜 debug — 今天 bug 看到你就会自觉修复',
    '宜写论文 — 灵感比 gradient descent 收敛得还快',
    '宜调 Agent — 它今天会听人话',
    '宜打天际线 — 市民不会堵在路上骂你',
    '宜 push — commit message 一次过审，不用 amend',
    '宜读 paper — 注意力比 self-attention 还集中',
    '宜摸鱼 — 但摸完会内疚，所以不如不摸',
  ],
  avoid: [
    '忌直接 git push — 至少先跑一遍 pnpm check',
    '忌改 config 不重启 dev server — 你会怀疑代码两小时',
    '忌在 main 上直接写新功能 — 哦等等，你已经这么干了',
    '忌多分区整理 — 会触发薛定谔的盘符',
    '忌凌晨三点跑实验 — 结果会和你一起困',
    '忌删 .cache — 重建时间够你打完一局天际线',
    '忌问 AI "这段代码为什么报错" — 它会比你更迷茫',
  ],
  rating: [
    '今日运势：pnpm build 一次通过 ★★★',
    '今日运势：loss 曲线单调下降 ★★★',
    '今日运势：所有 test 全绿 ★★★',
    '今日运势：市民满意度 98% ★★★',
    '今日运势：CSP 全过 ★★★',
  ],
};
---

<div class={cn('flex flex-col items-center md:py-2', className)} data-home-info-container={uniqueId}>
  <div
    class="home-avatar relative h-40 w-40 rounded-full"
    style={getLqipStyle(siteConfig.avatar ?? '/img/avatar.webp')}
    data-greet-morning={t(locale, 'homeInfo.greetingMorning')}
    data-greet-afternoon={t(locale, 'homeInfo.greetingAfternoon')}
    data-greet-evening={t(locale, 'homeInfo.greetingEvening')}
    data-greet-night={t(locale, 'homeInfo.greetingNight')}
  >
    <img
      class="h-full w-full rounded-full object-cover"
      src={siteConfig.avatar ?? '/img/avatar.webp'}
      alt={`${siteConfig.name ?? ''} avatar`}
      loading="eager"
      fetchpriority="high"
    />
    {christmasConfig.enabled && christmasConfig.features.christmasHat && <ChristmasHat />}
    <span class="home-greeting" aria-hidden="true"></span>
  </div>

  <p class="mt-2">{siteConfig?.name}</p>
  <p class="text-muted-foreground mt-3 text-center" data-random-description={JSON.stringify(descriptions)}>
    {descriptions[0]}
  </p>
  <Social />
  <div
    class="text-muted-foreground mt-3 flex justify-center text-center text-sm/4 whitespace-nowrap select-none dark:text-white/80"
  >
    <a href={localizedPath('/', locale)} class="hover:text-blue flex cursor-pointer flex-col gap-2 p-1 transition">
      <span class="text-lg/5 font-bold">{postCount}</span>
      {t(locale, 'homeInfo.articles')}
    </a>
    <div class="bg-muted-foreground mx-3 w-px"></div>
    <a href={localizedPath('/categories', locale)} aria-label={t(locale, 'homeInfo.categories')} class="hover:text-blue">
      <p class="flex cursor-pointer flex-col gap-2 p-1 transition">
        <span class="text-lg/5 font-bold">{Object.keys(countMap).length}</span>
        {t(locale, 'homeInfo.categories')}
      </p>
    </a>
    <div class="bg-muted-foreground mx-3 w-px"></div>
    <a href={localizedPath('/tags', locale)} class="hover:text-blue flex cursor-pointer flex-col gap-2 p-1 transition">
      <span class="text-lg/5 font-bold">{allTags?.length ?? 0}</span>
      {t(locale, 'homeInfo.tags')}
    </a>
  </div>

  {
    allTags.length > 0 && (
      <div class="mt-6 w-full px-3">
        <p class="text-muted-foreground/60 mb-2 text-sm tracking-widest">{t(locale, 'homeInfo.tags')}</p>
        <div class="flex flex-wrap justify-center gap-1.5">
          {allTags.map(({ tag, count }) => (
            <a
              href={localizedPath(buildTagPath(tag), locale)}
              class="text-muted-foreground rounded-full border border-foreground/15 px-3 py-1.5 text-base transition-colors hover:border-foreground/30 hover:text-foreground"
            >
              {tag}
              <span class="ml-1 text-sm opacity-60">{count}</span>
            </a>
          ))}
        </div>
      </div>
    )
  }
  <div
    class="mt-6 w-full px-3"
    data-fortune-good={JSON.stringify(fortunes.good)}
    data-fortune-avoid={JSON.stringify(fortunes.avoid)}
    data-fortune-rating={JSON.stringify(fortunes.rating)}
  >
    <p class="text-muted-foreground/60 mb-2 flex items-center gap-1.5 text-sm tracking-widest">
      <Icon name="ri:sparkling-2-fill" class="size-3.5 opacity-60" />
      今日运势
    </p>
    <div class="rounded-xl border border-foreground/10 bg-gradient-to-br from-foreground/[0.02] to-transparent p-3.5 text-sm leading-relaxed dark:from-white/[0.03] dark:to-transparent">
      <div class="flex items-start gap-2">
        <span class="mt-0.5 shrink-0 rounded bg-green-500/10 px-1.5 py-0.5 text-xs font-medium text-green-600 dark:text-green-400">宜</span>
        <p class="text-green-700 dark:text-green-300 text-sm" data-fortune-slot="good">{fortunes.good[0]}</p>
      </div>
      <div class="mt-2.5 flex items-start gap-2">
        <span class="mt-0.5 shrink-0 rounded bg-red-500/10 px-1.5 py-0.5 text-xs font-medium text-red-500 dark:text-red-400">忌</span>
        <p class="text-red-600 dark:text-red-300 text-sm" data-fortune-slot="avoid">{fortunes.avoid[0]}</p>
      </div>
      <div class="border-foreground/8 mt-2.5 border-t pt-2 dark:border-white/8">
        <p class="text-muted-foreground text-center text-xs" data-fortune-slot="rating">{fortunes.rating[0]}</p>
      </div>
    </div>
  </div>
  <!-- 导航按钮与顶栏重复，仅保留在移动端抽屉里；桌面侧栏不再渲染 -->
  {
    isDrawer && (
      <div class="mt-6 flex w-full flex-col items-center gap-2.5">
        {filteredRouters.map((item, index) => {
        const displayName = resolveNavName(item.nameKey, item.name, locale);
        if (item.children?.length) {
          const collapseId = `${uniqueId}-collapse-${index}`;
          return (
            <div
              class="flex w-40 flex-col rounded-xl transition-all duration-300"
              data-collapsible
            >
              <button
                class="flex-center hover:bg-foreground/5 h-12 w-full cursor-pointer rounded-xl text-base tracking-wider opacity-75 transition-all duration-300 hover:opacity-100 text-muted-foreground/80"
                data-collapse-trigger={collapseId}
                aria-expanded="false"
                aria-label={t(locale, 'common.menuLabel', { name: displayName })}
                type="button"
              >
                {item.icon && <Icon name={item.icon} class="mr-1.5" />}
                {displayName}
              </button>
              <div class="collapse-hidden" data-collapse-content={collapseId}>
                <div class="flex flex-col items-center">
                  {item.children.map((child) => {
                    const childName = resolveNavName(child.nameKey, child.name, locale);
                    const childUrl = child.path
                      ? child.localeIndependent
                        ? child.path
                        : localizedPath(child.path, locale)
                      : child.path;
                    return (
                      <ButtonLink
                        url={childUrl}
                        label={childName}
                        variant="gradient-shoka"
                        className={cn('shoka-button-shadow h-12 w-40 rounded-xl text-base tracking-wider', {
                          'text-muted-foreground/80 hover:bg-muted-foreground/10 bg-none shadow-none hover:shadow-none':
                            child.path !== strippedPath,
                        })}
                      >
                        {child.icon && <Icon name={child.icon} class="mr-1.5" />}
                        {childName}
                      </ButtonLink>
                    );
                  })}
                </div>
              </div>
            </div>
          );
        }
        const itemUrl = item.path ? (item.localeIndependent ? item.path : localizedPath(item.path, locale)) : item.path;
        return (
          <ButtonLink
            url={itemUrl}
            label={displayName}
            variant="gradient-shoka"
            className={cn(
              'shoka-button-shadow h-12 w-40 rounded-xl text-base tracking-wider opacity-75 transition-all duration-300 hover:opacity-100',
              {
                'text-muted-foreground/80 hover:bg-muted-foreground/10 bg-none shadow-none hover:shadow-none':
                  item.path !== strippedPath,
              },
            )}
          >
            {item.icon && <Icon name={item.icon} class="mr-1.5" />}
            {displayName}
          </ButtonLink>
        );
        })}
      </div>
    )
  }
</div>

<style>
  /* 折叠动画使用 CSS Grid 技巧实现平滑的高度过渡 */
  [data-collapse-content] {
    display: grid;
    /* 默认折叠：桌面端靠悬停展开，其它情况用点击切换 */
    grid-template-rows: 0fr;
  }

  [data-collapse-content] > div {
    min-height: 0;
    overflow: hidden;
  }

  /* 悬停或键盘聚焦时展开 */
  [data-collapsible]:hover [data-collapse-content],
  [data-collapsible]:focus-within [data-collapse-content],
  [data-collapse-content]:not(.collapse-hidden) {
    grid-template-rows: 1fr;
  }

  /* 只在用户未设置 reduce-motion 时应用动画 */
  @media (prefers-reduced-motion: no-preference) {
    [data-collapse-content] {
      transition: grid-template-rows 0.3s ease;
    }
  }
</style>
<script>
  let collapseMutationObserver: MutationObserver | null = null;

  /** The greeting follows the visitor's clock, so it is picked at hover time rather than at build time. */
  function greetingKey(hour: number): 'greetMorning' | 'greetAfternoon' | 'greetEvening' | 'greetNight' {
    if (hour >= 5 && hour < 12) return 'greetMorning';
    if (hour >= 12 && hour < 18) return 'greetAfternoon';
    if (hour >= 18 && hour < 23) return 'greetEvening';
    return 'greetNight';
  }

  // Delegated listener on document; the window flag keeps ClientRouter navigations from
  // stacking duplicate listeners (document persists across page swaps).
  const w = window as Window & { __homeGreetingDelegated?: boolean };
  if (!w.__homeGreetingDelegated) {
    w.__homeGreetingDelegated = true;
    document.addEventListener('pointerover', (event) => {
      const avatar = (event.target as Element | null)?.closest?.<HTMLElement>('.home-avatar');
      const bubble = avatar?.querySelector<HTMLElement>('.home-greeting');
      if (!avatar || !bubble || avatar.contains(event.relatedTarget as Node | null)) return;
      bubble.textContent = avatar.dataset[greetingKey(new Date().getHours())] ?? '';
    });
  }

  function pickRandomDescription() {
    document.querySelectorAll<HTMLElement>('[data-random-description]').forEach((el) => {
      if (el.dataset.descriptionInitialized) return;
      const raw = el.dataset.randomDescription;
      if (!raw) return;
      try {
        const options = JSON.parse(raw) as string[];
        if (options.length > 1) {
          el.textContent = options[Math.floor(Math.random() * options.length)] ?? options[0];
        }
      } catch {
        // Fallback: keep the default text
      }
      el.dataset.descriptionInitialized = 'true';
    });
  }

  function dateSeed(): number {
    const key = new Date().toISOString().slice(0, 10);
    let hash = 0;
    for (let i = 0; i < key.length; i++) hash = (hash * 31 + key.charCodeAt(i)) | 0;
    return Math.abs(hash);
  }

  function pickDailyFortune() {
    document.querySelectorAll<HTMLElement>('[data-fortune-good]').forEach((container) => {
      if (container.dataset.fortuneInitialized) return;
      const seed = dateSeed();
      const slots = ['good', 'avoid', 'rating'] as const;
      for (const slot of slots) {
        const raw = container.dataset[`fortune${slot.charAt(0).toUpperCase()}${slot.slice(1)}`];
        if (!raw) continue;
        try {
          const options = JSON.parse(raw) as string[];
          const el = container.querySelector<HTMLElement>(`[data-fortune-slot="${slot}"]`);
          if (el && options.length) {
            el.textContent = options[(seed + slots.indexOf(slot)) % options.length] ?? options[0];
          }
        } catch {
          // keep default
        }
      }
      container.dataset.fortuneInitialized = 'true';
    });
  }

  function initCollapsible() {
    // 找到所有 HomeInfo 容器
    const containers = document.querySelectorAll('[data-home-info-container]');

    containers.forEach((container) => {
      const triggers = container.querySelectorAll('[data-collapse-trigger]');

      triggers.forEach((trigger) => {
        const targetId = trigger.getAttribute('data-collapse-trigger');
        if (!targetId) return;

        // 检查是否已经初始化过
        if (trigger.hasAttribute('data-initialized')) return;
        trigger.setAttribute('data-initialized', 'true');

        // 在当前容器内查找对应的元素
        const content = container.querySelector(`[data-collapse-content="${targetId}"]`) as HTMLElement;

        if (!content) return;

        // 桌面端靠悬停展开（见上方样式），点击/键盘聚焦在这里切换显式状态。
        // 该状态会覆盖悬停样式，因此移开鼠标后仍保持展开。
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

          content.classList.toggle('collapse-hidden', isExpanded);
          trigger.setAttribute('aria-expanded', String(!isExpanded));
        });
      });
    });
  }

  function cleanupObserver() {
    if (collapseMutationObserver) {
      collapseMutationObserver.disconnect();
      collapseMutationObserver = null;
    }
  }

  function setupObserver() {
    // 先清理旧的观察器
    cleanupObserver();

    // 支持 MobileDrawer 延迟加载
    collapseMutationObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.addedNodes.length) {
          setTimeout(initCollapsible, 100);
        }
      });
    });

    collapseMutationObserver.observe(document.body, {
      childList: true,
      subtree: true,
    });
  }

  // 初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      pickRandomDescription();
      pickDailyFortune();
      initCollapsible();
      setupObserver();
    });
  } else {
    pickRandomDescription();
    pickDailyFortune();
    initCollapsible();
    setupObserver();
  }

  // 支持 Astro 的视图过渡
  document.addEventListener('astro:page-load', () => {
    pickRandomDescription();
    pickDailyFortune();
    initCollapsible();
    setupObserver();
  });

  // 页面切换前清理观察器
  document.addEventListener('astro:before-swap', cleanupObserver);
</script>
