---
import LogoSvg from '@assets/svg/logo.svg?react';
import logoSrc from '@assets/svg/logo.svg?url';
import ChristmasLights from '@components/christmas/ChristmasLights.astro';
import { ChristmasOrnamentToggle } from '@components/christmas/ChristmasOrnamentToggle';
import { MobilePostHeader } from '@components/layout/MobilePostHeader';
import { MenuIcon } from '@components/ui/MenuIcon';
import { MAX_WIDTH } from '@constants/layout';
import { christmasConfig, siteConfig } from 'constants/site-config';
import { getLocaleFromUrl } from '@/i18n';
import Navigator from './Navigator';

interface Props {
  isPostPage?: boolean;
  tocNumbering?: boolean;
}

const { isPostPage = false, tocNumbering = true } = Astro.props;
const { alternate, title, showLogo } = siteConfig;
const locale = getLocaleFromUrl(Astro.url.pathname);
---

<div
  id="site-header"
  class={`shadow-text fixed inset-x-0 top-0 z-30 gap-4 py-2.5 text-white select-none tablet:py-2 tablet:pl-3 tablet:pr-0 overflow-visible`}
>
  <!-- Do NOT reinstate `transition:name="site-header"` here: a view-transition
       name makes Chromium render this subtree as an atomic capture group, which
       silently disables every `backdrop-filter` inside it (verified 2026-10:
       blur(20px) on an in-header element rendered nothing until the name was
       removed; the theme transition already drops the name the same way). -->
  <!-- `.header-inner` carries the horizontal padding and owns the positioning
       context; `.header-content` is the flex row. They are kept separate so the
       capsule (inset against the inner box) can extend past the content row to
       the visual edge of the header. -->
  <div class={`header-inner mx-auto tablet:w-full px-6 tablet:pl-10 tablet:pr-3 ${MAX_WIDTH.content}`}>
    <!-- Frosted pill behind the header content; `.with-background` reveals it on scroll -->
    <div aria-hidden="true" class="header-capsule"></div>
    <div class="header-content flex items-center justify-between">
      <!-- Desktop: Always show logo -->
      <a
        transition:persist="page-header-avatar"
        class="site-logo tablet:hidden -my-4 mr-4 flex cursor-pointer items-center justify-center gap-1 whitespace-nowrap"
        href="/"
        target="_self"
        title={alternate || title}
        aria-label={alternate || title}
      >
        {showLogo ? <LogoSvg className="h-8" /> : <p class="logo-text">{alternate || title}</p>}
      </a>
      <!-- Mobile: MobilePostHeader (shows heading on post pages, logo otherwise) -->
      <div class="tablet:flex tablet:grow hidden items-center justify-center">
        <MobilePostHeader
          client:only="react"
          isPostPage={isPostPage}
          enableNumbering={tocNumbering}
          logoElement={showLogo ? 'svg' : 'text'}
          logoText={alternate || title}
          logoSrc={logoSrc}
        />
      </div>
      <Navigator client:load currentPath={Astro.url.pathname} locale={locale} />
    </div>
  </div>
  {christmasConfig.enabled && christmasConfig.features.christmasCoverDecoration && <ChristmasLights />}
  {christmasConfig.enabled && <ChristmasOrnamentToggle client:only="react" />}
</div>

<!-- 移动端菜单按钮 -->
<MenuIcon
  client:only="react"
  className="tablet:flex fixed top-0 left-3 z-52 hidden h-14 transition-transform"
  id="mobile-menu-container"
/>
