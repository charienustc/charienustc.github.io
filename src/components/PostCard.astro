---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  showTags?: boolean;
}

const { post, showTags = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const d = post.data.pubDate;
const dateStr = `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<a href={`${base}blog/${post.id}`} class="row group py-5 sm:py-6 flex items-baseline gap-4 sm:gap-7" data-reveal>
  <time datetime={d.toISOString()} class="label shrink-0 w-[5.5rem]">{dateStr}</time>
  <div class="flex-1 min-w-0">
    <h3 class="row-title font-serif text-base sm:text-lg font-semibold text-ink">
      {post.data.title}
    </h3>
    <p class="mt-1.5 text-sm text-ink-soft leading-relaxed line-clamp-2">
      {post.data.description}
    </p>
    {showTags && post.data.tags.length > 0 && (
      <div class="mt-2.5 flex flex-wrap gap-1.5">
        {post.data.tags.slice(0, 4).map((tag) => <span class="tag pointer-events-none">{tag}</span>)}
      </div>
    )}
  </div>
  <svg class="row-arrow w-4 h-4 shrink-0 self-center text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 12h14M12 5l7 7-7 7" />
  </svg>
</a>
