---
import { socials } from '../data/socials';
import { AUTHOR, SITE_DESCRIPTION } from '../consts';

const base = import.meta.env.BASE_URL;
---

<section class="pb-16 sm:pb-24">
  <div class="flex items-center gap-4 mb-6 sm:mb-8" data-reveal>
    <img
      src={base + 'avatar.jpg'}
      alt={`${AUTHOR} 的头像`}
      class="w-12 h-12 sm:w-14 sm:h-14 rounded-full object-cover ring-1 ring-line"
      onerror="this.style.display='none'"
    />
    <p class="label">USTC · 网络空间安全</p>
  </div>
  <h1
    class="font-serif text-6xl sm:text-8xl font-bold tracking-tight leading-[1.02] text-ink"
    data-reveal
    style="--reveal-delay: 60ms"
  >
    {AUTHOR}
  </h1>
  <p
    class="mt-6 sm:mt-8 text-lg sm:text-xl text-ink-soft leading-relaxed max-w-xl"
    data-reveal
    style="--reveal-delay: 120ms"
  >
    {SITE_DESCRIPTION}
  </p>
  <div
    class="mt-8 sm:mt-10 flex flex-wrap gap-x-7 gap-y-2 text-sm font-medium"
    data-reveal
    style="--reveal-delay: 180ms"
  >
    {socials.map((s) => {
      const isExternal = s.url.startsWith('http');
      return (
        <a
          href={s.url}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          class="link-underline text-ink-soft hover:text-ink"
        >
          {s.name}{isExternal && <span class="text-muted"> ↗</span>}
        </a>
      );
    })}
  </div>
</section>
