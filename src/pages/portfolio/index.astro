---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getCollection } from 'astro:content';
import { AUTHOR } from '../../consts';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.order - a.data.order);
---

<BaseLayout title={`项目 · ${AUTHOR}`} description={`${AUTHOR} 的项目与作品`}>
  <div class="reveal">
    <header class="mb-10 sm:mb-12">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-ink mb-3">项目</h1>
      <p class="text-ink-soft max-w-2xl">
        这里是我做过的一些项目与作品。精选项目会标有「精选」徽章。
      </p>
    </header>

    {projects.length === 0 ? (
      <EmptyState
        title="还没有展示的项目"
        description="正在整理中。可以先看看博客,了解我最近在做什么。"
        href={`${base}blog`}
        linkText="阅读博客"
      />
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
