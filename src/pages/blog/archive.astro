---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getCollection } from 'astro:content';
import { AUTHOR } from '../../consts';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title={`归档 · ${AUTHOR}`} description="按年份归档的文章">
  <PageHeader kicker="Archive" title="归档" desc="按年份整理的全部文章" />

  {years.length === 0 ? (
    <EmptyState title="还没有文章" description="敬请期待。" href={`${base}blog`} linkText="返回博客" />
  ) : (
    <div class="space-y-14">
      {years.map((year) => (
        <section data-reveal>
          <div class="flex items-baseline gap-3 mb-2">
            <h2 class="font-serif text-3xl font-bold text-ink tracking-tight">{year}</h2>
            <span class="label">{byYear.get(year)!.length} 篇</span>
          </div>
          <div>
            {byYear.get(year)!.map((post) => {
              const d = post.data.pubDate;
              const dateStr = `${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
              return (
                <a
                  href={`${base}blog/${post.id}`}
                  class="row group py-3.5 flex items-baseline gap-4 sm:gap-7"
                >
                  <span class="label shrink-0 w-[5.5rem]">{dateStr}</span>
                  <span class="row-title flex-1 min-w-0 font-medium text-ink">
                    {post.data.title}
                  </span>
                  <svg class="row-arrow w-4 h-4 shrink-0 self-center text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  )}

  <div class="mt-14">
    <a href={`${base}blog`} class="text-sm font-medium text-ink-soft hover:text-ink link-underline">
      ← 返回文章列表
    </a>
  </div>
</BaseLayout>
