---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import Tag from '../../components/Tag.astro';
import { getCollection, render } from 'astro:content';
import { AUTHOR } from '../../consts';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const base = import.meta.env.BASE_URL;
const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title={`${title} · ${AUTHOR}`} description={description} image={heroImage}>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>

  <article class="relative">
    {tocHeadings.length > 0 && (
      <nav class="toc" aria-label="文章目录" data-toc>
        <div class="toc-inner">
          {tocHeadings.map((h) => (
            <a href={`#${h.slug}`} class="toc-link" data-depth={h.depth} data-slug={h.slug}>
              <span class="toc-dash" aria-hidden="true"></span>
              <span class="toc-text">{h.text}</span>
            </a>
          ))}
        </div>
      </nav>
    )}
    <header class="mb-10 sm:mb-12" data-reveal>
      <p class="label mb-5">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && <span> · 更新于 {fmt(updatedDate)}</span>}
      </p>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-ink tracking-tight leading-[1.15]" style="text-wrap: balance">
        {title}
      </h1>
      <p class="mt-5 text-lg text-ink-soft leading-relaxed">{description}</p>
      {tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-1.5">
          {tags.map((tag) => <Tag tag={tag} />)}
        </div>
      )}
    </header>

    {heroImage && (
      <div class="mb-10 sm:mb-12 rounded-md overflow-hidden border border-line" data-reveal>
        <img
          src={heroImage.startsWith('http') ? heroImage : base + heroImage}
          alt={title}
          class="w-full object-cover"
        />
      </div>
    )}

    <div data-reveal>
      <Prose>
        <Content />
      </Prose>
    </div>

    <div class="mt-14 pt-6 border-t border-line flex items-center justify-between gap-4">
      <a href={`${base}blog`} class="text-sm font-medium text-ink-soft hover:text-ink link-underline">
        ← 返回文章列表
      </a>
      <span class="label hidden sm:inline">{AUTHOR}</span>
    </div>
  </article>

  <script>
    // 阅读进度:随滚动按比例拉伸顶部 2px 进度条。换页后进度条节点被替换,需重新取。
    const barEl = () => document.querySelector<HTMLElement>('[data-reading-progress]');

    function syncProgress() {
      const bar = barEl();
      if (!bar) return;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
      bar.style.transform = `scaleX(${ratio})`;
    }

    window.addEventListener('scroll', syncProgress, { passive: true });
    window.addEventListener('resize', syncProgress, { passive: true });
    document.addEventListener('astro:page-load', syncProgress);
    syncProgress();

    // 目录 scrollspy:视口顶部 120px 以上的最后一个标题即当前小节。
    // 元素一律惰性查询,换页后目录不存在时静默跳过。
    function syncToc() {
      const toc = document.querySelector('[data-toc]');
      if (!toc) return;
      const links = toc.querySelectorAll<HTMLElement>('.toc-link');
      const headings = document.querySelectorAll('.prose-custom h2[id], .prose-custom h3[id]');
      let current: string | null = null;
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= 120) current = h.id;
        else break;
      }
      // 页面滚到底时,最后一节可能永远跨不过阈值线 —— 直接点亮最后一个标题
      if (!current || window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2 && headings.length > 0) {
          current = headings[headings.length - 1].id;
        }
      }
      links.forEach((l) => {
        l.dataset.active = l.dataset.slug === current ? 'true' : 'false';
      });
    }

    window.addEventListener('scroll', syncToc, { passive: true });
    document.addEventListener('astro:page-load', syncToc);
    syncToc();
  </script>
</BaseLayout>
