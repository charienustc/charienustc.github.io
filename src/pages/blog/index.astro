---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getCollection } from 'astro:content';
import { AUTHOR } from '../../consts';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`博客 · ${AUTHOR}`} description={`${AUTHOR} 的博客文章`}>
  <PageHeader kicker="Blog" title="博客" desc={`共 ${posts.length} 篇文章`}>
    <div class="mt-5 flex items-center gap-6 text-sm font-medium">
      <a href={`${base}blog/tags`} class="link-underline text-ink-soft hover:text-ink">标签云</a>
      <a href={`${base}blog/archive`} class="link-underline text-ink-soft hover:text-ink">归档</a>
    </div>
  </PageHeader>

  {posts.length === 0 ? (
    <EmptyState
      title="还没有文章"
      description="第一篇还在路上。可以先看看项目,或者从归档了解我写过什么。"
      href={`${base}portfolio`}
      linkText="浏览项目"
    />
  ) : (
    <div>
      {posts.map((post) => (
        <PostCard post={post} showTags />
      ))}
    </div>
  )}
</BaseLayout>
