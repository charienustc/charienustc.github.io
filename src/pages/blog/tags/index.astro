---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { getCollection } from 'astro:content';
import { AUTHOR } from '../../../consts';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).filter((p) => !p.data.draft);

const tagCount = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title={`标签 · ${AUTHOR}`} description="全部文章标签">
  <PageHeader kicker="Tags" title="标签" desc={`共 ${tags.length} 个标签`} />

  {tags.length === 0 ? (
    <EmptyState title="还没有标签" href={`${base}blog`} linkText="返回博客" />
  ) : (
    <div>
      {tags.map(([tag, count]) => (
        <a
          href={`${base}blog/tags/${encodeURIComponent(tag)}`}
          class="row group py-4 flex items-baseline gap-4"
          data-reveal
        >
          <span class="row-title flex-1 min-w-0 font-serif text-lg font-bold text-ink">
            <span class="text-accent font-normal">#</span>{tag}
          </span>
          <span class="label shrink-0">{count} 篇</span>
          <svg class="row-arrow w-4 h-4 shrink-0 self-center text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      ))}
    </div>
  )}

  <div class="mt-14">
    <a href={`${base}blog`} class="text-sm font-medium text-ink-soft hover:text-ink link-underline">
      ← 返回文章列表
    </a>
  </div>
</BaseLayout>
