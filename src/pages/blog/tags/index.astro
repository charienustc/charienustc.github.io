---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { AUTHOR } from '../../../consts';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).filter((p) => !p.data.draft);

const tagCount = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title={`标签 · ${AUTHOR}`} description="全部文章标签">
  <div class="reveal max-w-3xl mx-auto">
    <header class="mb-10 sm:mb-12">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-ink mb-3">标签</h1>
      <p class="text-ink-soft">共 {tags.length} 个标签</p>
    </header>

    {tags.length === 0 ? (
      <div class="card p-8 text-center text-muted">
        还没有标签。
      </div>
    ) : (
      <div class="card p-6 sm:p-8">
        <div class="flex flex-wrap gap-3">
          {tags.map(([tag, count]) => (
            <a
              href={`${base}blog/tags/${encodeURIComponent(tag)}`}
              class="group inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent-soft text-accent font-medium hover:bg-accent hover:text-accent-text transition-colors"
            >
              #{tag}
              <span class="text-xs opacity-70 group-hover:opacity-100">{count}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="mt-12">
      <a href={`${base}blog`} class="inline-flex items-center text-sm font-medium text-accent hover:opacity-75 transition-opacity">
        <svg class="w-4 h-4 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        返回文章列表
      </a>
    </div>
  </div>
</BaseLayout>
