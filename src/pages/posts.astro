---
import HomeSider from '@components/layout/HomeSider.astro';
import PostList from '@components/post/PostList.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { CONTENT_PADDING } from '@constants/layout';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { siteTimezone } from '@lib/config/site';
import { getSortedPosts } from '@lib/content';
import { bucketPostsByMonth } from '@lib/content/index-groups';
import { toPostCardDataList } from '@lib/content/transforms';
import Divider from '@/components/ui/divider';
import { defaultLocale, t } from '@/i18n';

interface Props {
  locale?: string;
}

// Root pages render the default locale; `[lang]/` mirrors pass their locale in explicitly.
const { locale = defaultLocale } = Astro.props;
const posts = await getSortedPosts(locale);
const months = bucketPostsByMonth(posts, siteTimezone);
---

<Layout locale={locale} title={`${t(locale, 'posts.title')} | ${siteConfig.title}`} description={t(locale, 'posts.title')}>
  <TwoColumnLayout showPostFooter={false}>
    <Cover compact slot="cover" title={t(locale, 'posts.title')} />
    <HomeSider slot="sider" />
    <div
      class={`bg-gradient-start shadow-box tablet:shadow-none flex flex-col gap-6 overflow-hidden ${CONTENT_PADDING.standard}`}
    >
      {
        months.map((bucket) => (
          <section class="flex flex-col gap-4">
            <Divider>{t(locale, 'archives.monthLabel', { year: bucket.year, month: bucket.month, count: bucket.posts.length })}</Divider>
            <PostList posts={toPostCardDataList(bucket.posts, locale)} showPaginator={false} />
          </section>
        ))
      }
    </div>
  </TwoColumnLayout>
</Layout>
