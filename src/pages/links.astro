---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { socials } from '../data/socials';
import { AUTHOR } from '../consts';
---

<BaseLayout title={`链接 · ${AUTHOR}`} description="我的所有平台链接">
  <PageHeader kicker="Links" title="链接" desc="在这里可以找到我活跃的所有平台。" />

  <div>
    {socials.map((s) => {
      const isExternal = s.url.startsWith('http');
      return (
        <a
          href={s.url}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          class="row group py-5 flex items-baseline gap-4 sm:gap-7"
          data-reveal
        >
          <span class="row-title flex-1 min-w-0 font-serif text-lg sm:text-xl font-bold text-ink">
            {s.name}
          </span>
          {s.handle && (
            <span class="shrink-0 hidden sm:inline font-mono text-xs text-muted">{s.handle}</span>
          )}
          <span class="row-arrow shrink-0 self-center text-accent text-sm font-medium">
            {isExternal ? '↗' : '→'}
          </span>
        </a>
      );
    })}
  </div>
</BaseLayout>
