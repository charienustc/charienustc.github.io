---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { socials } from '../data/socials';
import { AUTHOR } from '../consts';
---

<BaseLayout title={`链接 · ${AUTHOR}`} description="我的所有平台链接">
  <div class="reveal max-w-3xl mx-auto">
    <header class="mb-10 sm:mb-12">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-ink mb-3">链接</h1>
      <p class="text-ink-soft">在这里可以找到我活跃的所有平台。</p>
    </header>

    <div class="grid gap-4 sm:grid-cols-2">
      {socials.map((s) => {
        const isExternal = !s.url.startsWith('/') && !s.url.startsWith('#');
        return (
          <Card
            href={s.url}
            class="group p-5 flex items-center gap-4"
          >
            <div class="w-12 h-12 rounded-2xl bg-accent-soft flex items-center justify-center text-accent shrink-0">
              {s.icon === 'github' ? (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.48 0-.24-.01-.86-.01-1.69-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.37 9.37 0 0 1 12 6.84c.85.01 1.71.12 2.51.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.81 0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z" />
                </svg>
              ) : s.icon === 'mail' ? (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
              ) : (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                </svg>
              )}
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="font-medium text-ink group-hover:text-accent transition-colors">{s.name}</span>
                {isExternal && (
                  <svg class="w-3.5 h-3.5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3" />
                  </svg>
                )}
              </div>
              {s.handle && (
                <p class="text-sm text-muted truncate">{s.handle}</p>
              )}
            </div>
          </Card>
        );
      })}
    </div>
  </div>
</BaseLayout>
