}
---

<BaseLayout title={`链接 · ${AUTHOR}`} description="科大常用链接">
  <PageHeader kicker="Links" title="链接" desc="中国科学技术大学常用链接。" />

  <div class="links-grid">
    {ustcLinks.map((s) => {
      const isExternal = s.url.startsWith('http');
      return (
        <a
          href={s.url}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          class="link-card group"
          data-reveal
        >
          <div class="link-icon" set:html={getIcon(s.icon)} />
          <div class="link-content">
            <div class="link-name">{s.name}</div>
            {s.handle && <div class="link-handle">{s.handle}</div>}
          </div>
          <div class="link-arrow">
            {isExternal ? '↗' : '→'}
          </div>
        </a>
      );
    })}
  </div>
</BaseLayout>

<style>
  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }

  .link-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--field);
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    text-decoration: none;
  }

  .link-card:hover {
    border-color: var(--accent);
    background: var(--surface);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.12);
  }

  .link-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent);
    transition: all 0.3s ease;
  }

  .link-icon :deep(svg) {
    width: 20px;
    height: 20px;
  }

  .link-card:hover .link-icon {
    background: var(--accent);
    color: var(--paper);
    transform: scale(1.05);
  }

  .link-content {
    flex: 1;
    min-width: 0;
  }

  .link-name {
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 2px;
    transition: color 0.2s ease;
  }

  .link-card:hover .link-name {
    color: var(--accent);
  }

  .link-handle {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-arrow {
    flex-shrink: 0;
    font-size: 18px;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .link-card:hover .link-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 640px) {
    .links-grid {
      grid-template-columns: 1fr;
    }

    .link-card {
      padding: 16px 20px;
    }

    .link-icon {
      width: 36px;
      height: 36px;
    }

    .link-icon :deep(svg) {
      width: 18px;
      height: 18px;
    }

    .link-name {
      font-size: 15px;
    }
  }
</style>
